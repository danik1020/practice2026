<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandLib\CommandLib.csproj" />
  </ItemGroup>
  <Target Name="CopyFileSystemCommands" AfterTargets="Build">
    <Copy SourceFiles="..\FileSystemCommands\bin\$(Configuration)\net8.0\FileSystemCommands.dll"
          DestinationFolder="$(OutputPath)" />
  </Target>

</Project>